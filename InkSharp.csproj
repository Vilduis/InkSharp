<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>InkSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Metadatos del paquete NuGet -->
    <PackageId>InkSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vilder Luis</Authors>
    <Description>Generador de PDF 100% nativo para .NET, sin dependencias externas. Facturas y reportes con tablas (celdas combinadas), texto, imágenes JPEG/PNG, encabezado y pie, y paginación automática.</Description>
    <PackageTags>pdf;pdf-generator;pdf-writer;reports;invoice;netstandard;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Vilduis/InkSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Vilduis/InkSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- El proyecto de ejemplo vive dentro de la carpeta pero no forma parte de la librería -->
    <Compile Remove="samples/**" />
    <None Remove="samples/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
